{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.satashili/toolsocket",
  "title": "ToolSocket",
  "description": "660+ data tools for agents: TikTok, Douyin, Instagram, YouTube, X, weather, GitHub. Pay per call.",
  "version": "0.1.0",
  "websiteUrl": "https://toolsocket.top/docs",
  "repository": {
    "url": "https://github.com/satashili/toolsocket",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://toolsocket.top/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "toolsocket",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "TOOLSOCKET_API_KEY",
          "description": "API key from https://toolsocket.top/console",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
